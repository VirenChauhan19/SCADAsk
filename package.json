{
  "name": "scadask-recreation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "generate": "node scripts/create-editorial-site.mjs",
    "prepare:reference": "node scripts/prepare-reference.mjs",
    "check": "node scripts/check.mjs && node scripts/check-content.mjs",
    "check:content": "node scripts/check-content.mjs",
    "capture:content": "node scripts/collect-original-content.mjs --refresh && node scripts/import-content-media.mjs",
    "build": "node scripts/build-site.mjs",
    "mirror": "node scripts/mirror-site.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "ask:answers": "node scripts/build-ask-answers.mjs"
  },
  "devDependencies": {
    "cheerio": "1.2.0",
    "vite": "^8.3.1"
  }
}
